# ============ AI Gomoku 后端环境变量模板 ============
# 复制为 .env 后填写真实值（.env 已被 .gitignore 排除，不会提交）
# 密钥按"配置 ID"绑定：LLM_API_KEY_{config_id}
# 例如模型配置 id=2 的 key → LLM_API_KEY_2=sk-xxxx
# 也可用单个 LLM_API_KEY 作为所有配置的兜底

# LLM_API_KEY_2=
# LLM_API_KEY_3=
# LLM_API_KEY_4=
# LLM_API_KEY_5=
# LLM_API_KEY=

# 数据库连接（可选覆盖，默认指向 backend/ 目录下的 gomoku.db）
# DATABASE_URL=sqlite:///D:/work/AI_WuZiQi/backend/gomoku.db

# 可选 API Key 认证（P0 安全）：设置后所有 /api/* 请求需带 X-Api-Key 头，
# 未设置则完全放行（默认单机/局域网开箱即用）。前端需在请求头带上同一 token。
# AUTH_TOKEN=your-secret-token

# CORS 允许来源（可选覆盖，逗号分隔；默认含本地开发端口 5173/3000/8000）
# CORS_ORIGINS=http://localhost:5173,http://localhost:8000
